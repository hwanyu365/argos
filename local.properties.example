# local.properties 로 복사해서 값을 채운다. local.properties 는 .gitignore 대상이다.
# 같은 이름의 환경변수로도 줄 수 있으며, local.properties 값이 우선한다.
sdk.dir=/path/to/Android/Sdk

# Firebase 콘솔 > 프로젝트 설정 > 내 앱(Android) 에서 확인
ARGOS_FIREBASE_API_KEY=
ARGOS_FIREBASE_APP_ID=
ARGOS_FIREBASE_PROJECT_ID=
# Realtime Database 화면 상단의 URL (예: https://<project>-default-rtdb.asia-southeast1.firebasedatabase.app)
ARGOS_FIREBASE_DATABASE_URL=

# release 서명 (선택). 비우면 unsigned APK 가 만들어진다
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
